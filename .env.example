# --- GitHub API ---------------------------------------------------------
# Fine-grained personal access token; read-only access to public data is
# enough (no scopes needed). Raises the rate limit from 60 to 5,000 req/hr.
# Also accepted with the project prefix: REPORADAR_GITHUB_TOKEN.
GITHUB_TOKEN=

# Identify ourselves to every API we call (etiquette + contactability).
REPORADAR_USER_AGENT="reporadar (independent research project; deeasonsitaula5@gmail.com)"

# --- Data & endpoints (defaults shown; uncomment to override) -------------
# Where downloaded data lands (GH Archive hours, live poll samples).
#REPORADAR_DATA_DIR=data

# Override only to point at a mirror or a test double.
#REPORADAR_API_BASE=https://api.github.com
#REPORADAR_ARCHIVE_BASE=https://data.gharchive.org

# --- Streaming (Kafka) ----------------------------------------------------
# Where the event producer connects. The default matches the local stack's
# host listener (localhost:${KAFKA_PORT}); point it at your broker elsewhere.
#REPORADAR_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic that live-captured events are produced onto.
#REPORADAR_KAFKA_LIVE_TOPIC=raw.events.live

# --- Local stack (docker-compose.yml) -------------------------------------
# Host ports are shifted off the defaults so the stack coexists with other
# local projects; override if these also collide. Passwords have no default —
# the stack refuses to start until you set them here.
#KAFKA_PORT=9092
#POSTGRES_PORT=5433
#POSTGRES_USER=reporadar
#POSTGRES_DB=reporadar
POSTGRES_PASSWORD=
#GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=
