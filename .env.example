# --- GitHub API ---------------------------------------------------------
# Fine-grained personal access token; read-only access to public data is
# enough (no scopes needed). Raises the rate limit from 60 to 5,000 req/hr.
# Also accepted with the project prefix: REPORADAR_GITHUB_TOKEN.
GITHUB_TOKEN=

# Identify ourselves to every API we call (etiquette + contactability).
REPORADAR_USER_AGENT="reporadar (independent research project; deeasonsitaula5@gmail.com)"

# --- Data & endpoints (defaults shown; uncomment to override) -------------
# Where downloaded data lands (GH Archive hours, live poll samples).
#REPORADAR_DATA_DIR=data

# Override only to point at a mirror or a test double.
#REPORADAR_API_BASE=https://api.github.com
#REPORADAR_ARCHIVE_BASE=https://data.gharchive.org

# --- Streaming (Kafka) ----------------------------------------------------
# Where the event producer connects. The default matches the local stack's
# host listener (localhost:${KAFKA_PORT}); point it at your broker elsewhere.
#REPORADAR_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic that live-captured events are produced onto.
#REPORADAR_KAFKA_LIVE_TOPIC=raw.events.live

# Topic that undecodable messages are dead-lettered onto, for triage and replay.
#REPORADAR_KAFKA_DLQ_TOPIC=raw.events.dlq

# --- Deduplication --------------------------------------------------------
# How many recent event ids each loop remembers when dropping duplicates.
# Larger costs memory (roughly this many short strings) and buys a longer
# duplication horizon; an id seen again after this many *newer* ids have
# arrived is counted as fresh. Size it to real traffic and cycle interval —
# this window bounds duplicate suppression only, and says nothing about what
# share of the feed is seen: nothing measures that, deliberately.
#REPORADAR_SEEN_WINDOW=50000

# --- Validated store (TimescaleDB) ----------------------------------------
# Where consumed, validated events are written. No default — it carries a
# password, and a wrong-by-default database is worse than an absent one; only
# the consumer needs it (polling runs without a database). For the local stack,
# this is the compose Postgres: same user/db/password as below, on POSTGRES_PORT.
REPORADAR_POSTGRES_DSN=postgresql://reporadar:CHANGEME@localhost:5433/reporadar

# --- Local stack (docker-compose.yml) -------------------------------------
# Host ports are shifted off the defaults so the stack coexists with other
# local projects; override if these also collide. Passwords have no default —
# the stack refuses to start until you set them here.
#KAFKA_PORT=9092
#POSTGRES_PORT=5433
#POSTGRES_USER=reporadar
#POSTGRES_DB=reporadar
POSTGRES_PASSWORD=
#GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=

# The password for the database role the dashboard reads through — a different
# role from the application's, allowed to read the published aggregates and the
# hours record and nothing else. Set it here, then run `make grafana-grants`
# once to create the role; Grafana refuses to start until this is set, because a
# dashboard that silently falls back to the owning role would defeat the point.
GRAFANA_DB_PASSWORD=

# --- Containerised services (docker compose --profile app) -------------------
# Bounds for the long-running services when they run as containers. They are
# command-line arguments rather than application settings, because they belong
# to an invocation rather than to a deployment; these variables exist so the
# compose file does not have to be edited to change one.
#
# How long between archive gap scans. The published record changes hourly, so
# scanning faster buys only promptness after publication, never more coverage.
#ARCHIVE_SCAN_INTERVAL_S=900

# How many archive hours convert at once. Bounded because the publisher is
# somebody else's server and politeness is a property of the client.
#ARCHIVE_CONCURRENCY=3

# How far back each scan looks. Too short and downtime longer than the window
# leaves hours nothing revisits; unbounded and every pass rediscovers years of
# settled hours. Anything older is what `reporadar backfill` is for.
#ARCHIVE_LOOKBACK_DAYS=3

# Live poller cadence and pages per cycle. The API states a minimum interval in
# every response and the slower of the two is used, so lowering this below what
# it asks for has no effect beyond spending quota.
#SERVE_INTERVAL_S=10
#SERVE_PAGES=3

# --- Topic provisioning ------------------------------------------------------
# Partition count for BOTH topics. They are sized identically on purpose: the
# dead-letter record keeps the original repo id as its key, so a repository's
# poison messages land on the partition its live events use. Raising this later
# re-maps every key and breaks per-repository ordering, so size it once, up
# front, with `reporadar provision`.
#REPORADAR_KAFKA_TOPIC_PARTITIONS=3

# Replication factor for provisioned topics. 1 suits the single-broker local
# stack; a multi-broker cluster wants 3. Above the number of registered brokers
# the broker refuses outright. Note that replication alone is only half of
# durability — the producer currently uses acks=1, so RF>1 buys less than it
# looks like until acks and min.insync.replicas are set together.
#REPORADAR_KAFKA_TOPIC_REPLICATION_FACTOR=1
